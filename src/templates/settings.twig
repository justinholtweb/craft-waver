{# Secondary actions post through `Craft.sendActionRequest` rather than their own `<form>`: this
   template is already inside Craft's settings form, and a nested form does not submit. #}
{% js %}
(function() {
    var result = document.getElementById('waver-connection-result');

    function say(text, isError) {
        result.textContent = text;
        result.style.color = isError ? '#cf1124' : '';
    }

    function tokenField() {
        return document.querySelector('input[name="settings[accessToken]"]');
    }

    var test = document.querySelector('[data-waver-test]');
    if (test) {
        test.addEventListener('click', function() {
            say({{ 'Asking Wave…'|t('waver')|json_encode|raw }}, false);
            Craft.sendActionRequest('POST', 'waver/settings/test')
                .then(function(response) {
                    var data = response.data;
                    say(data.message, !data.success);
                    if (data.businesses && data.businesses.length) {
                        var list = document.createElement('ul');
                        data.businesses.forEach(function(business) {
                            var item = document.createElement('li');
                            var code = document.createElement('code');
                            code.textContent = business.id;
                            item.appendChild(document.createTextNode(business.name + ' — '));
                            item.appendChild(code);
                            list.appendChild(item);
                        });
                        result.appendChild(list);
                    }
                })
                .catch(function(error) {
                    say((error.response && error.response.data && error.response.data.message) || {{ 'Could not reach Wave.'|t('waver')|json_encode|raw }}, true);
                });
        });
    }

    var check = document.querySelector('[data-waver-check-business]');
    if (check) {
        check.addEventListener('click', function() {
            var field = document.querySelector('input[name="settings[businessId]"]');
            say({{ 'Asking Wave…'|t('waver')|json_encode|raw }}, false);
            Craft.sendActionRequest('POST', 'waver/settings/check-business', {
                data: { businessId: field ? field.value : '' }
            })
                .then(function(response) {
                    var data = response.data;
                    say(data.message, !data.success);
                    (data.warnings || []).forEach(function(warning) {
                        var p = document.createElement('p');
                        p.className = 'warning';
                        p.textContent = warning;
                        result.appendChild(p);
                    });
                })
                .catch(function() { say({{ 'Could not reach Wave.'|t('waver')|json_encode|raw }}, true); });
        });
    }

    function post(action, confirmText) {
        if (confirmText && !window.confirm(confirmText)) {
            return;
        }
        Craft.sendActionRequest('POST', action, { data: { redirect: window.location.pathname } })
            .then(function() { window.location.reload(); })
            .catch(function() { Craft.cp.displayError({{ 'That did not work.'|t('waver')|json_encode|raw }}); });
    }

    var refresh = document.querySelector('[data-waver-refresh]');
    if (refresh) {
        refresh.addEventListener('click', function() { post('waver/settings/refresh'); });
    }

    var clear = document.querySelector('[data-waver-clear-maps]');
    if (clear) {
        clear.addEventListener('click', function() {
            post('waver/settings/clear-maps', {{ 'Clear the customer and product maps? Wave itself is untouched, but unmatched customers and products will be created again.'|t('waver')|json_encode|raw }});
        });
    }
})();
{% endjs %}
