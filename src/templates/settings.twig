{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks perfect, Craft says "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

{% set commerceReady = craft.app.plugins.isPluginEnabled('commerce') %}

{# Account menus are built from Wave's cached chart of accounts. An empty option is always first
   so that an unconfigured install is honestly blank rather than silently pointing at whichever
   account happened to sort first. #}
{% set accountOptions = [{ label: '—'|t('waver'), value: '' }] %}
{% set anchorOptions = [{ label: '—'|t('waver'), value: '' }] %}
{% for account in accounts %}
    {% set accountOptions = accountOptions|merge([{ label: account.getLabel(), value: account.id }]) %}
    {% if account.isAnchorCandidate() %}
        {% set anchorOptions = anchorOptions|merge([{ label: account.getLabel(), value: account.id }]) %}
    {% endif %}
{% endfor %}

{% set statusList = [] %}
{% if commerceReady %}
    {% for status in craft.commerce.orderStatuses.getAllOrderStatuses() %}
        {% set statusList = statusList|merge([{ label: status.name, value: status.handle }]) %}
    {% endfor %}
{% endif %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Waver needs it to do anything.'|t('waver') }}</p>
    </div>
{% endif %}

{% if not isPro %}
    <div class="pane" style="border-left: 3px solid #cdd8e4;">
        <p>
            <strong>{{ 'You’re running Waver Lite.'|t('waver') }}</strong>
            {{ 'Invoice mode, refunds, the connection log, per-store businesses, per-gateway accounts and the sales tax map are Pro features. Their settings are shown below but have no effect until you upgrade.'|t('waver') }}
        </p>
    </div>
{% endif %}

{# ------------------------------------------------------------------ #}
<h2>{{ 'Connection'|t('waver') }}</h2>

<div class="pane">
    <p>
        {{ 'Create an application in Wave’s developer portal, then generate a full access token for it. The token reaches every business on your Wave account, so keep it in an environment variable rather than in the database.'|t('waver') }}
    </p>
</div>

{{ forms.autosuggestField({
    label: 'Access token'|t('waver'),
    instructions: 'Sent to Wave as `Authorization: Bearer …`.'|t('waver'),
    id: 'accessToken',
    name: 'accessToken',
    value: settings.accessToken,
    suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
    label: 'Business'|t('waver'),
    instructions: 'The Wave business id orders are recorded against. Use “Test connection” below to list the ids this token can reach.'|t('waver'),
    id: 'businessId',
    name: 'businessId',
    value: settings.businessId,
    suggestEnvVars: true,
    class: 'code'
}) }}

<div class="field">
    <div class="heading"><label>{{ 'Check it works'|t('waver') }}</label></div>
    <div class="input">
        <div class="buttons">
            <button type="button" class="btn" data-waver-test>{{ 'Test connection'|t('waver') }}</button>
            <button type="button" class="btn" data-waver-check-business>{{ 'Check business'|t('waver') }}</button>
        </div>
        <div id="waver-connection-result" class="light" style="margin-top: 8px;"></div>
    </div>
</div>

{{ forms.textField({
    label: 'Timeout'|t('waver'),
    instructions: 'Seconds to wait on Wave before giving up.'|t('waver'),
    id: 'timeout',
    name: 'timeout',
    type: 'number',
    size: 5,
    value: settings.timeout
}) }}

{# ------------------------------------------------------------------ #}
<hr>
<h2>{{ 'What gets recorded'|t('waver') }}</h2>

{{ forms.selectField({
    label: 'Record each order as'|t('waver'),
    instructions: 'A **money transaction** is one call, needs no Wave catalogue, and books the money to the cent — the right choice for a storefront that has already been paid. An **invoice** is a document you can send, but Wave computes its own tax, every line needs a matching Wave product, and shipping has nowhere to go.'|t('waver')|md,
    id: 'recordAs',
    name: 'recordAs',
    value: settings.recordAs,
    options: [
        { label: 'A money transaction'|t('waver'), value: 'transaction' },
        { label: 'An invoice (Pro)'|t('waver'), value: 'invoice' }
    ]
}) }}

{% if settings.recordAs == 'invoice' and not isPro %}
    <p class="warning">{{ 'Invoice mode is a Pro feature. Orders will be recorded as money transactions until you upgrade.'|t('waver') }}</p>
{% endif %}

{{ forms.lightswitchField({
    label: 'Record orders automatically'|t('waver'),
    instructions: 'Off leaves everything to the order screen and the console commands.'|t('waver'),
    id: 'autoSync',
    name: 'autoSync',
    on: settings.autoSync
}) }}

{{ forms.selectField({
    label: 'Record when'|t('waver'),
    id: 'syncTrigger',
    name: 'syncTrigger',
    value: settings.syncTrigger,
    options: [
        { label: 'The order is completed'|t('waver'), value: 'complete' },
        { label: 'The order reaches a status (Pro)'|t('waver'), value: 'status' },
        { label: 'Never — only on request'|t('waver'), value: 'manual' }
