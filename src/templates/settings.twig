}) }}

{{ forms.lightswitchField({
    label: 'Only record orders paid in full'|t('waver'),
    instructions: 'A money transaction says cash arrived. With this on, an order with an outstanding balance is skipped with a note rather than posted as income you have not received.'|t('waver'),
    id: 'requireFullyPaid',
    name: 'requireFullyPaid',
    on: settings.requireFullyPaid
}) }}

{{ forms.textField({
    label: 'Description'|t('waver'),
    instructions: 'An object template rendered against the order. This is what you will read in Wave’s transaction list.'|t('waver'),
    id: 'descriptionTemplate',
    name: 'descriptionTemplate',
    value: settings.descriptionTemplate,
    class: 'code'
}) }}

{{ forms.textField({
    label: 'Rounding tolerance'|t('waver'),
